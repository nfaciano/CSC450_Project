          RowBox[{"x", ",", "1.42698", ",", 
           RowBox[{"-", "2.90586"}]}], "}"}]}], "]"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "sinusoidal", " ", "ground"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ground", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "x", "]"}], "+", "2"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
