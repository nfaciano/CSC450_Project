Notebook[{

Cell[CellGroupData[{
Cell["\<\
Comparative Analysis of Linear Approximation and True Derivative\
\>", "Title",
 CellChangeTimes->{{3.9182519407013054`*^9, 
  3.918251956175728*^9}},ExpressionUUID->"4dd7965d-550f-074c-9216-\
18371b0a627f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "function", " ", "and", " ", "its", " ", 
    "derivative"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Exp", "[", "x", "]"}], " ", 
      RowBox[{"Sin", "[", "x", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fPrime", "[", "x_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Exp", "[", "x", "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Sin", "[", "x", "]"}], "+", 
        RowBox[{"Cos", "[", "x", "]"}]}], ")"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Data", " ", "for", " ", "exact", " ", "and", " ", "approximate", " ", 
     "derivatives", " ", "at", " ", "given", " ", "points"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"points", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "5"}], ",", 
       RowBox[{"-", "4"}], ",", 
       RowBox[{"-", "3"}], ",", 
       RowBox[{"-", "2"}], ",", 
       RowBox[{"-", "1"}], ",", "0", ",", "1", ",", "2", ",", "3", ",", "4", 
       ",", "5"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"exactDerivatives", "=", 
     RowBox[{"{", 
      RowBox[{"0.00837248", ",", "0.00188942", ",", 
       RowBox[{"-", "0.0563148"}], ",", 
       RowBox[{"-", "0.179379"}], ",", 
       RowBox[{"-", "0.110794"}], ",", "1", ",", "3.75605", ",", "3.64392", 
       ",", 
       RowBox[{"-", "17.0501"}], ",", 
       RowBox[{"-", "77.0078"}], ",", 
       RowBox[{"-", "100.218"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"approxDerivatives", "=", 
     RowBox[{"{", 
      RowBox[{"0.00837189", ",", "0.00188965", ",", 
       RowBox[{"-", "0.0563108"}], ",", 
       RowBox[{"-", "0.179376"}], ",", 
       RowBox[{"-", "0.110805"}], ",", "1", ",", "3.75617", ",", "3.64351", 
       ",", 
       RowBox[{"-", "17.0488"}], ",", 
       RowBox[{"-", "77.0016"}], ",", 
       RowBox[{"-", "100.212"}]}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Combine", " ", "points", " ", "with", " ", "their", " ", "exact", " ", 
     "and", " ", "approximate", " ", "derivatives"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"exactPoints", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"points", ",", "exactDerivatives"}], "}"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"approxPoints", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"points", ",", "approxDerivatives"}], "}"}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Identify", " ", "local", " ", "maxima", " ", "and", " ", "minima", " ", 
     "by", " ", "finding", " ", "where", " ", "the", " ", "derivative", " ", 
     "is", " ", "zero"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"criticalPoints", "=", 
     RowBox[{"x", "/.", " ", 
      RowBox[{"NSolve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"fPrime", "[", "x", "]"}], "==", "0"}], "&&", 
         RowBox[{
          RowBox[{"-", "6"}], "<", "x", "<", "6"}]}], ",", "x", ",", 
        "Reals"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Evaluate", " ", "the", " ", "second", " ", "derivative", " ", "to", " ", 
     "classify", " ", "maxima", " ", "and", " ", "minima"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"secondDeriv", "=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"fPrime", "[", "x", "]"}], ",", "x"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Classify", " ", "critical", " ", "points"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maximaPoints", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"criticalPoints", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"secondDeriv", "/.", " ", 
           RowBox[{"x", "->", "#"}]}], ")"}], "<", "0"}], "&"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"minimaPoints", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"criticalPoints", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"secondDeriv", "/.", " ", 
           RowBox[{"x", "->", "#"}]}], ")"}], ">", "0"}], "&"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Prepare", " ", "graphics", " ", "for", " ", "maxima", " ", "and", " ", 
     "minima", " ", "if", " ", "they", " ", "exist"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maximaGraphics", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "maximaPoints", "]"}], ">", "0"}], ",", 
       RowBox[{"{", 
        RowBox[{"Green", ",", 
         RowBox[{"PointSize", "[", "Large", "]"}], ",", 
         RowBox[{"Point", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", 
              RowBox[{"f", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
           "maximaPoints"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"minimaGraphics", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "minimaPoints", "]"}], ">", "0"}], ",", 
       RowBox[{"{", 
        RowBox[{"Purple", ",", 
         RowBox[{"PointSize", "[", "Large", "]"}], ",", 
         RowBox[{"Point", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", 
              RowBox[{"f", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
           "minimaPoints"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Plot", " ", "the", " ", "function"}], ",", 
     RowBox[{"exact", " ", "and", " ", "approximate", " ", "derivatives"}], 
     ",", 
     RowBox[{"and", " ", "annotate", " ", "critical", " ", "points"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"funcPlot", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"f", "[", "x", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "6"}], ",", "6"}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"exactDerivPlot", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"exactPoints", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Red", ",", 
          RowBox[{"PointSize", "[", "Medium", "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotMarkers", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\[FilledCircle]\>\"", ",", "12"}], "}"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"approxDerivPlot", "=", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"approxPoints", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", 
         RowBox[{"Blue", ",", 
          RowBox[{"PointSize", "[", "Medium", "]"}]}], "}"}]}], ",", 
       RowBox[{"PlotMarkers", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<\[EmptyCircle]\>\"", ",", "12"}], "}"}]}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Show", " ", "combined", " ", "plot", " ", "with", " ", "annotations", 
     " ", "for", " ", "maxima", " ", "and", " ", "minima"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Show", "[", 
    RowBox[{"funcPlot", ",", "exactDerivPlot", ",", "approxDerivPlot", ",", 
     RowBox[{"Graphics", "[", "maximaGraphics", "]"}], ",", 
     RowBox[{"Graphics", "[", "minimaGraphics", "]"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"GridLinesStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Gray", ",", "Dashed"}], "]"}]}], ",", 
     RowBox[{"ImageSize", "->", "Large"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<Value\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", 
      "\"\<Function and Derivatives with Critical Points Annotated\>\""}]}], 
    "]"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9182508674891605`*^9, 3.918250867490158*^9}, 
   3.9182519589522896`*^9},ExpressionUUID->"2220a38f-cfca-ec4b-8e6f-\
4ba2e01fa177"],

