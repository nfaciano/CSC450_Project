Cell[CellGroupData[{

Cell["\<\
Estimating the Derivative at a Point\[LineSeparator] Linear approximation & \
Improved version\
\>", "Title",
 CellChangeTimes->{{3.918255018326277*^9, 
  3.9182550530483913`*^9}},ExpressionUUID->"2e040c8e-a67b-484c-b513-\
5b764583c2da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "function", " ", "and", " ", "its", " ", 
    "derivative"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", 
    RowBox[{"Sin", "[", "x", "]"}]}], "\n", 
   RowBox[{
    RowBox[{"fPrime", "[", "x_", "]"}], ":=", 
    RowBox[{"Cos", "[", "x", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "linear", " ", "approximation", " ", "of", " ",
      "the", " ", "derivative"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"linearApprox", "[", 
     RowBox[{"f_", ",", "x_", ",", "h_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"x", "+", "h"}], "]"}], "-", 
       RowBox[{"f", "[", "x", "]"}]}], ")"}], "/", "h"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "improved", " ", "approximation", " ", "of", 
     " ", "the", " ", "derivative"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"improvedApprox", "[", 
     RowBox[{"f_", ",", "x_", ",", "h_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"f", "[", 
        RowBox[{"x", "+", "h"}], "]"}], "-", 
       RowBox[{"f", "[", 
        RowBox[{"x", "-", "h"}], "]"}]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", "h"}], ")"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "absolute", " ", "and", " ", "relative", " ", 
     "error", " ", "functions"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"absoluteError", "[", 
     RowBox[{"true_", ",", "approx_"}], "]"}], ":=", 
    RowBox[{"Abs", "[", 
     RowBox[{"true", "-", "approx"}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"relativeError", "[", 
     RowBox[{"true_", ",", "approx_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"true", "-", "approx"}], "]"}], "/", 
     RowBox[{"Abs", "[", "true", "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Choose", " ", "a", " ", "point", " ", "for", " ", "the", " ", 
     "derivative", " ", "approximation"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"x0", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "a", " ", "plot", " ", "for", " ", "the", " ", "linear", 
     " ", "approximation", " ", "errors"}], "*)"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"absoluteError", "[", 
        RowBox[{
         RowBox[{"fPrime", "[", "x0", "]"}], ",", 
         RowBox[{"linearApprox", "[", 
          RowBox[{"f", ",", "x0", ",", "h"}], "]"}]}], "]"}], ",", 
       RowBox[{"relativeError", "[", 
        RowBox[{
         RowBox[{"fPrime", "[", "x0", "]"}], ",", 
         RowBox[{"linearApprox", "[", 
          RowBox[{"f", ",", "x0", ",", "h"}], "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"h", ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}], ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "1"}]}]}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotLabels", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Absolute Error Linear\>\"", ",", 
        "\"\<Relative Error Linear\>\""}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Red"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", "\"\<Expressions\>\""}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Create", " ", "a", " ", "plot", " ", "for", " ", "the", " ", "improved", 
     " ", "approximation", " ", "errors"}], "*)"}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"absoluteError", "[", 
        RowBox[{
         RowBox[{"fPrime", "[", "x0", "]"}], ",", 
         RowBox[{"improvedApprox", "[", 
          RowBox[{"f", ",", "x0", ",", "h"}], "]"}]}], "]"}], ",", 
       RowBox[{"relativeError", "[", 
        RowBox[{
         RowBox[{"fPrime", "[", "x0", "]"}], ",", 
         RowBox[{"improvedApprox", "[", 
          RowBox[{"f", ",", "x0", ",", "h"}], "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"h", ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "6"}]}], ",", 
       RowBox[{"10", "^", 
        RowBox[{"-", "1"}]}]}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotLabels", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<Absolute Error Improved\>\"", ",", 
        "\"\<Relative Error Improved\>\""}], "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Green", ",", "Orange"}], "}"}]}], ",", 
     RowBox[{"PlotLegends", "->", "\"\<Expressions\>\""}]}], "]"}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{3.918142401173034*^9},
 CellLabel->"In[29]:=",ExpressionUUID->"3c817c5c-5d26-264f-83e0-e9bf7aa867cd"],

