Notebook[{

Cell[CellGroupData[{
Cell["Linear approximation to a function", "Title",
 CellChangeTimes->{{3.9182549243498306`*^9, 
  3.918254951282198*^9}},ExpressionUUID->"60c4c7d0-9869-3047-9010-\
204eae4d85b6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f1", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{
      RowBox[{"x", "^", "5"}], "-", "1"}], "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"x", "^", "3"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f2", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Cos", "[", "x", "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"2", "  ", "x"}], "]"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "+", 
          RowBox[{"Sin", "[", "x", "]"}]}], ")"}], "^", "2"}]}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f3", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Cos", "[", "x", "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"2", "  ", "x"}], "]"}], "/", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"Sin", "[", "x", "]"}]}], ")"}], "^", "2"}]}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f4", "[", "x_", "]"}], ":=", 
    RowBox[{"x", "  ", 
     RowBox[{"Sin", "[", 
      RowBox[{"1", "/", "x"}], "]"}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Choose", " ", "a", " ", "point", " ", "and", " ", "h", " ", "for", " ", 
    "linear", " ", "approximation"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "=", "0.0000001"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Small", " ", "h", " ", "value", " ", "for", " ", "approximation"}], 
   "*)"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "symmetric", " ", "difference", " ", "quotient",
     " ", "for", " ", "derivative", " ", "approximation"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DerivativeApproximation", "[", 
    RowBox[{"f_", ",", "x0_", ",", "h_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x0", "+", "h"}], "]"}], "-", 
      RowBox[{"f", "[", 
       RowBox[{"x0", "-", "h"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"2", "*", "h"}], ")"}]}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "derivative", " ", "approximations", " ", "at", " ", 
    "x0"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f1DerivativeApprox", "=", 
   RowBox[{"DerivativeApproximation", "[", 
    RowBox[{"f1", ",", "x0", ",", "h"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f2DerivativeApprox", "=", 
   RowBox[{"DerivativeApproximation", "[", 
    RowBox[{"f2", ",", "x0", ",", "h"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"f3DerivativeApprox", "=", 
   RowBox[{"DerivativeApproximation", "[", 
    RowBox[{"f3", ",", "x0", ",", "h"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f4DerivativeApprox", "=", 
    RowBox[{"DerivativeApproximation", "[", 
     RowBox[{"f4", ",", "x0", ",", "h"}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "linear", " ", "approximation", " ", 
    "functions"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"lf1", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"f1", "[", "x0", "]"}], "+", 
    RowBox[{"f1DerivativeApprox", "*", 
     RowBox[{"(", 
      RowBox[{"x", "-", "x0"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lf2", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"f2", "[", "x0", "]"}], "+", 
    RowBox[{"f2DerivativeApprox", "*", 
     RowBox[{"(", 
      RowBox[{"x", "-", "x0"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lf3", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"f3", "[", "x0", "]"}], "+", 
    RowBox[{"f3DerivativeApprox", "*", 
     RowBox[{"(", 
      RowBox[{"x", "-", "x0"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lf4", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"f4", "[", "x0", "]"}], "+", 
    RowBox[{"f4DerivativeApprox", "*", 
     RowBox[{"(", 
      RowBox[{"x", "-", "x0"}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.918140495692272*^9, 3.918140495693266*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"00e84e84-579d-c34f-91aa-670c6ee219b8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f1", "[", "x", "]"}], ",", 
     RowBox[{"lf1", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"x0", "-", "2"}], ",", 
     RowBox[{"x0", "+", "2"}]}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<f1\>\"", ",", "\"\<Linear Approximation of f1\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Red"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f2", "[", "x", "]"}], ",", 
     RowBox[{"lf2", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"x0", "-", "2"}], ",", 
     RowBox[{"x0", "+", "2"}]}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<f2\>\"", ",", "\"\<Linear Approximation of f2\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Red"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f3", "[", "x", "]"}], ",", 
     RowBox[{"lf3", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"x0", "-", "2"}], ",", 
     RowBox[{"x0", "+", "2"}]}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<f3\>\"", ",", "\"\<Linear Approximation of f3\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Red"}], "}"}]}]}], "]"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f4", "[", "x", "]"}], ",", 
     RowBox[{"lf4", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"x0", "-", "2"}], ",", 
     RowBox[{"x0", "+", "2"}]}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<f4\>\"", ",", "\"\<Linear Approximation of f4\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{"Blue", ",", "Red"}], "}"}]}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{{3.9181405282413177`*^9, 3.9181405525776176`*^9}},
