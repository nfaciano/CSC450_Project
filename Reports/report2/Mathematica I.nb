Cell[CellGroupData[{

Cell["Linear approximation to a function\nAnalysis:", "Title",
 CellChangeTimes->{{3.918254970116686*^9, 
  3.9182549727616024`*^9}},ExpressionUUID->"0b78f2c8-09cf-6341-b403-\
212edc53203f"],

Cell["\<\
For Function 1, f_1(x), the plot displays the function in blue and its linear \
approximation in red. Near x_0 = 2, the linear approximation is accurate as \
it closely follows the tangent to the function at this point. However, \
further from  x_0 , particularly for x < x_0 , the function shows oscillatory \
behavior due to the x^5 term in the cosine function. This behavior is more \
complex than what can be represented by a linear trend, leading to a \
noticeable divergence between the function and its approximation.

For Function 2, f_2(x), if the plot were visible, we would expect to see \
difficulties in linear approximation near points where the denominator \
approaches zero, as this would indicate vertical asymptotes or sharp turns in \
the function. A linear approximation is inadequate near such points due to \
the rapidly changing behavior of the function, which cannot be captured by a \
single linear slope.

When linear approximations fail, it may be due to:

- High Curvature: At points of steep curvature, the \
function\[CloseCurlyQuote]s rate of change is too great for a straight line \
to provide an accurate approximation.
- Oscillatory Behavior: Rapid oscillations in a function, such as seen with \
the cos(x^5 - 1) term in  f_1, are not well-captured by a linear approximation.
- Discontinuities or Asymptotes: Linear approximations cannot replicate the \
behavior of functions at points of discontinuity or vertical asymptotes.

A detailed analysis would involve examining the derivatives at x_0 and the \
function\[CloseCurlyQuote]s behavior around this point. While the derivative \
gives the slope of the tangent line and thus the linear approximation, any \
peculiarities or complex behavior of the function can render this \
approximation ineffective at capturing the true nature of the function\
\[CloseCurlyQuote]s behavior.\
\>", "Text",
 CellChangeTimes->{{3.918140590013857*^9, 
  3.9181406252752514`*^9}},ExpressionUUID->"3e844568-d80a-fc44-9d6a-\
7ef262ac014c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Taylor-Lagrange formula", "Title",
 CellChangeTimes->{
  3.918254990920969*^9},ExpressionUUID->"5aae0460-5ed7-b14c-9e89-\
448efd9595bc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "functions"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"f1", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{
       RowBox[{"x", "^", "5"}], "-", "1"}], "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"x", "^", "3"}]}], ")"}]}]}], "\n", 
   RowBox[{
    RowBox[{"f2", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Cos", "[", "x", "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "x"}], "]"}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "+", 
           RowBox[{"Sin", "[", "x", "]"}]}], ")"}], "^", "2"}]}]}], ")"}]}]}],
    "\n", 
   RowBox[{
    RowBox[{"f3", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"Cos", "[", "x", "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "x"}], "]"}], "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{"Sin", "[", "x", "]"}]}], ")"}], "^", "2"}]}]}], ")"}]}]}],
    "\n", 
   RowBox[{
    RowBox[{"f4", "[", "x_", "]"}], ":=", 
    RowBox[{"x", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"1", "/", "x"}], "]"}]}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Define", " ", "a", " ", "function", " ", "to", " ", "plot", " ", "a", 
      " ", "function"}], ",", 
     RowBox[{"its", " ", "Taylor", " ", "polynomial"}], ",", 
     RowBox[{
     "and", " ", "the", " ", "remainder", " ", "term", " ", "estimate"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"PlotTaylorLagrangeApproximation", "[", 
     RowBox[{"f_", ",", "a_", ",", "b_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "taylorPolynomial", ",", "remainderEstimatePlot", ",", "taylorPlot", 
        ",", "originalFunctionPlot"}], "}"}], ",", 
      RowBox[{
       RowBox[{"taylorPolynomial", "=", 
        RowBox[{"Normal", "[", 
         RowBox[{"Series", "[", 
          RowBox[{
           RowBox[{"f", "[", "x", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", "a", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Since", " ", "we", " ", "cannot", " ", "know", " ", "the", " ", 
          "exact", " ", "c"}], ",", 
         RowBox[{
          RowBox[{
          "we", " ", "plot", " ", "the", " ", "maximum", " ", "value", " ", 
           "of", " ", "the", " ", "n"}], "-", 
          RowBox[{
          "th", " ", "derivative", " ", "as", " ", "an", " ", 
           "estimate"}]}]}], "*)"}], 
       RowBox[{"remainderEstimatePlot", "=", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"f", "^", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"n", "+", "1"}], ")"}], "[", "x", "]"}]}], "/", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"n", "+", "1"}], ")"}], "!"}]}], "]"}], "*", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"b", "-", "x"}], ")"}], "^", 
            RowBox[{"(", 
             RowBox[{"n", "+", "1"}], ")"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", "Red"}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{
          "PlotLabel", "->", "\"\<Remainder Term Estimate R_n(x)\>\""}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"taylorPlot", "=", 
        RowBox[{"Plot", "[", 
         RowBox[{"taylorPolynomial", ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", "Blue"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"originalFunctionPlot", "=", 
        RowBox[{"Plot", "[", 
         RowBox[{
          RowBox[{"f", "[", "x", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "a", ",", "b"}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", "Green"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Show", "[", 
        RowBox[{
        "originalFunctionPlot", ",", "taylorPlot", ",", 
         "remainderEstimatePlot", ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"{", 
           RowBox[{
           "\"\<f(x)\>\"", ",", "\"\<Taylor Polynomial\>\"", ",", 
            "\"\<Remainder Estimate\>\""}], "}"}]}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "for", " ", "each", " ", "function"}], "*)"}], "\n", 
   RowBox[{"PlotTaylorLagrangeApproximation", "[", 
    RowBox[{"f1", ",", "0", ",", "1", ",", "4"}], "]"}], "\n", 
   RowBox[{"PlotTaylorLagrangeApproximation", "[", 
    RowBox[{"f2", ",", "0", ",", "1", ",", "4"}], "]"}], "\n", 
   RowBox[{"PlotTaylorLagrangeApproximation", "[", 
    RowBox[{"f3", ",", "0", ",", "1", ",", "4"}], "]"}], "\n", 
   RowBox[{"PlotTaylorLagrangeApproximation", "[", 
    RowBox[{"f4", ",", "0", ",", "1", ",", "4"}], "]"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9181406747474957`*^9, 3.918140674748466*^9}, 
   3.918141075676588*^9},ExpressionUUID->"91b7e090-4115-3447-8d22-\
95209811c699"],

