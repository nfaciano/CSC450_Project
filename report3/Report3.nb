Cell["\<\
 Steps to Reproduce the Analysis:
1. **Data Import**: The data is imported from a CSV file containing time \
stamps and positions.
2. **Plot Trajectory**: A 3D point plot is created for the positions with \
each point styled in red.
3. **Define Ground Function**: A mathematical function is defined to simulate \
the ground surface.
4. **Plot Ground**: The ground function is plotted as a 3D surface with a \
blue semi-transparent style.
5. **Combine Plots**: Both the trajectory plot and the ground plot are \
combined into a single visualization.

The output should be a 3D plot showing the trajectory of an object as it \
moves through space above the ground surface defined by `groundFunction`.\
\>", "WolframAlphaShort",
 CellChangeTimes->{{3.9210789397339506`*^9, 
  3.9210789600472565`*^9}},ExpressionUUID->"b11a5137-ec4f-3f46-a00f-\
6f07d621ec47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "function"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", "-", "3"}], ")"}], "^", "2"}], "+", "5"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "derivative", " ", "of", " ", "the", " ", 
     "function"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"df", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"f", "[", "y", "]"}], ",", "y"}], "]"}], "/.", " ", 
     RowBox[{"y", "->", "x"}]}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "initial", " ", "guess"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x0", "=", "0"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "step", " ", "size"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alpha", "=", "0.1"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "convergence", " ", "threshold", " ", "for", 
     " ", "the", " ", "gradient"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"epsilon", "=", "0.001"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "maximum", " ", "number", " ", "of", " ", 
     "iterations"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxIterations", "=", "100"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Implement", " ", "the", " ", "gradient", " ", "descent", " ", 
     "algorithm"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gradientDescent", "[", 
     RowBox[{
     "f_", ",", "df_", ",", "x0_", ",", "alpha_", ",", "epsilon_", ",", 
      "maxIterations_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "=", "x0"}], ",", "grad", ",", 
        RowBox[{"k", "=", "0"}], ",", 
        RowBox[{"xHistory", "=", 
         RowBox[{"{", "x0", "}"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"Repeat", "[", 
        RowBox[{
         RowBox[{"grad", "=", 
          RowBox[{"df", "[", "x", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", "grad", "]"}], "<", "epsilon"}], "||", 
            RowBox[{"k", ">=", "maxIterations"}]}], ",", 
           RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"x", "=", 
          RowBox[{"x", "-", 
           RowBox[{"alpha", "*", "grad"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"xHistory", ",", "x"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"k", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\"\<Minimum\>\"", "->", "x"}], ",", 
         RowBox[{"\"\<FunctionValue\>\"", "->", 
          RowBox[{"f", "[", "x", "]"}]}], ",", 
         RowBox[{"\"\<Iterations\>\"", "->", "k"}], ",", 
         RowBox[{"\"\<History\>\"", "->", "xHistory"}]}], "}"}]}]}], "]"}]}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Execute", " ", "the", " ", "gradient", " ", "descent", " ", 
     "algorithm"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"result", "=", 
    RowBox[{"gradientDescent", "[", 
     RowBox[{
     "f", ",", "df", ",", "x0", ",", "alpha", ",", "epsilon", ",", 
      "maxIterations"}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Output", " ", "the", " ", "result"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<The local minimum occurs at x = \>\"", ",", 
      RowBox[{"result", "[", "\"\<Minimum\>\"", "]"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<The value of the function at the minimum is \>\"", ",", 
      RowBox[{"result", "[", "\"\<FunctionValue\>\"", "]"}]}], "]"}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Number of iterations: \>\"", ",", 
      RowBox[{"result", "[", "\"\<Iterations\>\"", "]"}]}], "]"}], ";"}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{3.920811727897648*^9, 3.9210791467625675`*^9},
 CellLabel->"In[25]:=",ExpressionUUID->"20e99d77-c63e-6045-9e17-26d8f2374e58"],

