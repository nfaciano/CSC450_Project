Notebook[{

Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Data", " ", "Import"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"Import", "[", 
      RowBox[{
      "\"\<C:\\\\Users\\\\nickf\\\\OneDrive\\\\Desktop\\\\CSC450_Project\\\\\
Reports\\\\report3\\\\trajectory.csv\>\"", ",", "\"\<CSV\>\"", ",", 
       RowBox[{"\"\<HeaderLines\>\"", "->", "1"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"times", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"positions", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", 
        RowBox[{"2", ";;", "4"}]}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "trajectory"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"trajectoryPlot", "=", 
     RowBox[{"ListPointPlot3D", "[", 
      RowBox[{"positions", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "Red", "}"}]}], ",", 
       RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "ground", " ", 
     RowBox[{"function", ".", "This"}], " ", "should", " ", "match", " ", 
     "the", " ", "myGroundFunction", " ", "from", "  ", 
     RowBox[{"C", "++"}], " ", 
     RowBox[{"code", "."}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"groundFunction", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"0.05", " ", "x"}], "+", 
      RowBox[{"0.1", " ", "y"}], "+", 
      RowBox[{"20.0", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "0.01"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "50.0"}], ")"}], "^", "2"}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"y", "-", "50.0"}], ")"}], "^", "2"}]}], ")"}]}], 
        "]"}]}], "+", 
      RowBox[{"5.0", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"x", "/", "10.0"}], "]"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"y", "/", "10.0"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]",
    "\n", 
   RowBox[{"(*", 
    RowBox[{"Plot", " ", "the", " ", "ground", " ", "function"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"groundPlot", "=", 
     RowBox[{"Plot3D", "[", 
      RowBox[{
       RowBox[{"groundFunction", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "100"}], ",", "600"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", 
         RowBox[{"-", "100"}], ",", "600"}], "}"}], ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"Mesh", "->", "None"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Opacity", "[", 
         RowBox[{"0.5", ",", "Blue"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Combine", " ", "the", " ", "plots"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"combinedPlot", "=", 
     RowBox[{"Show", "[", 
      RowBox[{"groundPlot", ",", "trajectoryPlot", ",", 
       RowBox[{"AxesLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}], 
       ",", 
       RowBox[{"BoxRatios", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "0.5"}], "}"}]}], ",", 
       RowBox[{"ImageSize", "->", "Large"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", "combinedPlot", "\n"}]}]], "Input",
 CellChangeTimes->{{3.9208107621932487`*^9, 3.9208107621942635`*^9}, {
  3.9210788953277397`*^9, 3.92107889993993*^9}, {3.921079370195177*^9, 
